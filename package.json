{
  "name": "prismai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bash scripts/integration/test_integrations.sh",
    "test:integration:supabase": "node scripts/integration/test_supabase_connection.mjs",
    "test:integration:r2": "node scripts/integration/test_r2_connection.mjs",
    "test:integration:gemini": "node scripts/integration/test_provider_gemini.mjs",
    "test:integration:groq": "node scripts/integration/test_provider_groq.mjs",
    "format:check": "prettier --check .",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
