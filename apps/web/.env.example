# URL et clé publique anon/publishable du projet Supabase de développement ou staging.
# Ne place jamais SUPABASE_SERVICE_ROLE_KEY dans l’application Web.
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Origine publique des callbacks Auth, autorisée dans Supabase Auth.
APP_BASE_URL=http://localhost:3000
# false uniquement en HTTP localhost ; mettre true si le site est servi en HTTPS.
SUPABASE_COOKIE_SECURE=false

# Catalogue JSON explicite, validé côté serveur. Aucun modèle par défaut n’est supposé.
# Chaque entrée attend provider, model réel, capabilities, contextWindowTokens, plans et qualityRank.
# Exemple de clés provider reconnues : GROQ_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY, MISTRAL_API_KEY.
# Les clés et le catalogue sont uniquement serveur et ne doivent jamais être préfixés NEXT_PUBLIC_.
PRISMAI_ROUTING_CATALOG=
AI_TIMEOUT_MS=30000
