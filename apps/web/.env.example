# URL et clé publique anon/publishable du projet Supabase de développement ou staging.
# Ne place jamais SUPABASE_SERVICE_ROLE_KEY dans l’application Web.
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Origine publique des callbacks Auth, autorisée dans Supabase Auth.
APP_BASE_URL=http://localhost:3000
# false uniquement en HTTP localhost ; mettre true si le site est servi en HTTPS.
SUPABASE_COOKIE_SECURE=false

# Catalogue JSON explicite, validé côté serveur. Aucun modèle par défaut n’est supposé.
# Chaque entrée attend provider, model réel, capabilities, contextWindowTokens, plans et qualityRank.
# Les providers sans barème historique (ex. Cloudflare, Hugging Face, SambaNova, Z.AI) exigent aussi creditClass: groq, gemini, openrouter ou mistral.
# Exemple de clés provider reconnues : GROQ_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY, MISTRAL_API_KEY, CLOUDFLARE_API_TOKEN, HF_TOKEN, SAMBANOVA_API_KEY, ZAI_API_KEY.
# Les clés et le catalogue sont uniquement serveur et ne doivent jamais être préfixés NEXT_PUBLIC_.
# Les paramètres IA ci-dessous sont facultatifs : sans clé/catalogue, l’application démarre et désactive l’IA.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HF_TOKEN=
SAMBANOVA_API_KEY=
ZAI_API_KEY=
# Pollinations : placeholders documentaires uniquement; les studios Image/Vidéo ne sont pas encore reliés à cette API.
# La clé secrète reste côté serveur; les générations Pollinations peuvent consommer le solde Pollen du compte.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=
POLLINATIONS_VIDEO_MODEL=
PRISMAI_ROUTING_CATALOG=
AI_TIMEOUT_MS=30000
# À définir à true uniquement après vérification dans AI Studio du modèle et du quota Free utilisés par le test.
GEMINI_TEST_FREE_CONFIRMED=false
# À définir à true uniquement après vérification dans GroqCloud du modèle et des limites Free du compte.
GROQ_TEST_FREE_CONFIRMED=false
# À définir à true après confirmation que le modèle explicitement choisi est gratuit et que le compte n’utilisera pas de crédits payants.
OPENROUTER_TEST_FREE_CONFIRMED=false
# À définir à true uniquement après vérification de l’allocation mensuelle Free disponible dans le Workspace Mistral.
MISTRAL_TEST_FREE_CONFIRMED=false
# À définir à true seulement après vérification du modèle exact, du quota de neurons restant et de l’absence de facturation payante.
CLOUDFLARE_TEST_FREE_CONFIRMED=false
# Le plan Free Hugging Face n’inclut pas de crédit d’inférence; confirmer que le modèle exact est actuellement marqué gratuit et qu’aucun solde payant ne sera débité.
HF_TEST_FREE_CONFIRMED=false
# Les limites SambaNova Free varient par modèle et les pages de conditions ne concordent pas toujours; confirmer le modèle et le quota visibles dans le compte.
SAMBANOVA_TEST_FREE_CONFIRMED=false
# Certains modèles Z.AI affichent un prix nul sans garantir de quota; vérifier modèle, région et solde du compte avant confirmation.
ZAI_TEST_FREE_CONFIRMED=false
