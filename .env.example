# Port HTTP local de l’API PrismAI.
PRISMAI_API_PORT=3001

# URL Supabase utilisée côté serveur et client SSR.
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
# Clé anon destinée au client SSR ; elle ne remplace jamais la clé service.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Origine publique des callbacks Auth, autorisée dans Supabase Auth.
APP_BASE_URL=http://localhost:3000
# Clé service strictement backend, jamais préfixée NEXT_PUBLIC_ et jamais envoyée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Mettre true pour tout accès HTTPS (y compris Preview) ; false uniquement en HTTP localhost.
SUPABASE_COOKIE_SECURE=false

# Secrets de signature webhook, uniquement côté serveur.
STRIPE_WEBHOOK_SECRET=replace-me
CAMPAY_WEBHOOK_SECRET=replace-me
CINETPAY_WEBHOOK_SECRET=replace-me
